<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dormhive Logo</title>

<style>
    body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #f5f6f8;
    }

    .logo {
        width: 180px;
        height: 180px;
    }

    svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }
</style>
</head>

<body>

<div class="logo">

<svg viewBox="0 0 180 180"
     xmlns="http://www.w3.org/2000/svg">

    <defs>

        <!-- Premium dark gradient -->
        <linearGradient id="navy"
            x1="20" y1="10"
            x2="160" y2="170"
            gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#203E69"/>
            <stop offset="0.55" stop-color="#102B4F"/>
            <stop offset="1" stop-color="#071B35"/>
        </linearGradient>

        <!-- Gold -->
        <linearGradient id="gold"
            x1="70" y1="30"
            x2="120" y2="145"
            gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FFE08A"/>
            <stop offset="0.35" stop-color="#F5BE42"/>
            <stop offset="1" stop-color="#C98213"/>
        </linearGradient>

        <!-- Soft shadow -->
        <filter id="shadow"
            x="-30%" y="-30%"
            width="160%"
            height="170%">

            <feDropShadow
                dx="0"
                dy="12"
                stdDeviation="10"
                flood-opacity="0.20"/>
        </filter>

        <!-- Gold glow -->
        <filter id="glow">
            <feGaussianBlur
                stdDeviation="2.5"
                result="blur"/>

            <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
            </feMerge>
        </filter>

    </defs>


    <!-- =================================
         OUTER PREMIUM MARK
         ================================= -->

    <path
        d="
        M90 8
        C126 8 157 36 162 71
        C167 106 148 139 119 157
        C108 164 98 169 90 172
        C82 169 72 164 61 157
        C32 139 13 106 18 71
        C23 36 54 8 90 8Z
        "
        fill="url(#navy)"
        filter="url(#shadow)"
    />


    <!-- =================================
         INNER GOLD RING
         ================================= -->

    <path
        d="
        M90 20
        C120 20 146 43 150 72
        C154 101 139 128 114 144
        C105 150 97 154 90 157
        C83 154 75 150 66 144
        C41 128 26 101 30 72
        C34 43 60 20 90 20Z
        "
        fill="none"
        stroke="url(#gold)"
        stroke-width="2"
        opacity=".75"
    />


    <!-- =================================
         ABSTRACT HIVE CELLS
         ================================= -->

    <!-- Top cell -->
    <path
        d="M90 31
           L105 40
           L105 57
           L90 66
           L75 57
           L75 40Z"
        fill="none"
        stroke="url(#gold)"
        stroke-width="3"
        opacity=".9"
    />

    <!-- Left cell -->
    <path
        d="M55 55
           L70 64
           L70 81
           L55 90
           L40 81
           L40 64Z"
        fill="none"
        stroke="url(#gold)"
        stroke-width="3"
        opacity=".55"
    />

    <!-- Right cell -->
    <path
        d="M125 55
           L140 64
           L140 81
           L125 90
           L110 81
           L110 64Z"
        fill="none"
        stroke="url(#gold)"
        stroke-width="3"
        opacity=".55"
    />


    <!-- =================================
         MAIN D / HOME SYMBOL
         ================================= -->

    <!-- D outer silhouette -->
    <path
        d="
        M59 54
        L59 122
        C59 133 67 139 78 139
        L91 139
        C119 139 137 121 137 96
        C137 71 119 54 91 54
        Z

        M78 71
        L91 71
        C108 71 119 81 119 96
        C119 111 108 122 91 122
        L78 122
        Z
        "
        fill="white"
        fill-rule="evenodd"
    />


    <!-- =================================
         HOUSE ROOF HIDDEN INSIDE D
         ================================= -->

    <path
        d="
        M69 88
        L89 69
        L109 88
        "
        fill="none"
        stroke="url(#gold)"
        stroke-width="5"
        stroke-linecap="round"
        stroke-linejoin="round"
        filter="url(#glow)"
    />


    <!-- =================================
         DOOR
         ================================= -->

    <path
        d="
        M82 119
        L82 99
        C82 94 85 91 90 91
        C95 91 98 94 98 99
        L98 119
        "
        fill="url(#gold)"
    />


    <!-- Door center -->
    <circle
        cx="94"
        cy="105"
        r="2"
        fill="#102B4F"
    />


    <!-- =================================
         HIVE DOTS
         ================================= -->

    <circle
        cx="90"
        cy="42"
        r="3"
        fill="#FFE08A"
    />

    <circle
        cx="48"
        cy="72"
        r="2.5"
        fill="#F5BE42"
        opacity=".8"
    />

    <circle
        cx="132"
        cy="72"
        r="2.5"
        fill="#F5BE42"
        opacity=".8"
    />


    <!-- =================================
         BOTTOM BRAND ACCENT
         ================================= -->

    <path
        d="M68 148
           C75 152 83 155 90 158
           C97 155 105 152 112 148"
        fill="none"
        stroke="url(#gold)"
        stroke-width="3"
        stroke-linecap="round"
    />

</svg>

</div>

</body>
</html>
